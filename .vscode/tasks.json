{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build EmailOperations",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/EmailOperations/EmailOperations.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build NotificationService",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/NotificationService/NotificationService.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
