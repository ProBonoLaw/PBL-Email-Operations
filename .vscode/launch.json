{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Notification Service API (Test)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/NotificationService/bin/Debug/net10.0/NotificationService.dll",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build NotificationService",
      "env": {
        "APPSETTINGS_FILE": "${workspaceFolder}/.local/appsettings.notification-aks-test.json",
        "ASPNETCORE_URLS": "http://127.0.0.1:5080"
      }
    },
    {
      "name": "Email Operations: communication hub (Test)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/EmailOperations/bin/Debug/net10.0/EmailOperations.dll",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build EmailOperations",
      "env": {
        "ROLE": "communication-hub",
        "APPSETTINGS_FILE": "${workspaceFolder}/.local/appsettings.communication-hub.json",
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential",
        "EVENTHUB_TRANSPORT_TYPE": "AmqpWebSockets"
      }
    },
