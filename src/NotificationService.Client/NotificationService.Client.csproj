<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>ProBonoLaw.EmailOperations.NotificationService.Client</PackageId>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/probonolaw/Probono-Law-Email-Operations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Typed HTTP client and contracts for transmitting NotificationService notices.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../NotificationService/openapi.json" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
