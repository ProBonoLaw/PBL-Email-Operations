{
  "openapi": "3.1.0",
  "info": {
    "title": "NotificationService API",
    "version": "1.0.0",
    "description": "Internal API. Validates a notice, assigns id/read/createdAt, persists it in Cosmos DB, then broadcasts to Web PubSub group USER_<oid>. No application authentication; access is restricted by the internal network. A failed broadcast can leave a persisted notice. Retries can conflict; clients should not retry automatically."
  },
  "servers": [
    {
      "url": "http://notification-service.email-operations.svc.cluster.local"
    }
  ],
  "paths": {
    "/api/sendNotice": {
      "post": {
        "operationId": "sendNotice",
        "summary": "Persist and broadcast a notification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendNoticeRequest"
              },
              "example": {
                "oid": "client-object-id",
                "notificationType": "INGESTION",
                "data": {
                  "accountId": "account-id",
                  "filepath": "/file.pdf",
                  "status": "PRELIMINARY"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted and broadcast successfully. No response body."
          },
          "400": {
            "description": "Invalid JSON or invalid notice payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Invalid request payload."
              }
            }
          },
          "500": {
            "description": "Persistence or broadcast failed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Process health probe",
        "responses": {
          "200": {
            "description": "Process is running. No response body."
          }
        }
      }
    },
    "/openapi/v1.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "Get this OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
